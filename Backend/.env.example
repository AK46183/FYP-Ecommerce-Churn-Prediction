# Copy to .env and fill in. Never commit .env, never paste these values in chats or screenshots.
# Random keys:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Databases
POSTGRES_URI=
MONGO_URI=

# Security (required: server refuses to start without them)
JWT_SECRET=                # 64+ random hex characters
DATA_ENCRYPTION_KEY=       # exactly 64 hex characters; encrypts phone numbers and addresses. Keep a safe copy: losing it means losing that data
CORS_ORIGINS=http://localhost:5173
SKINCARE_SERVICE_KEY=      # same value as in skincare-ai/.env
TRUST_PROXY=               # set to 1 when deployed behind Render / Vercel proxy

# Google sign-in (Client ID only; the client secret is not used)
GOOGLE_CLIENT_ID=

# Services
PORT=5000
FRONTEND_URL=http://localhost:5173
SKINCARE_AI_URL=http://127.0.0.1:8001
CHURN_API_URL=

# Email (optional; without it emails are printed in the terminal)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=                 # Gmail app password, not your Gmail password
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_EMAIL_ALERTS=

# Optional tuning
CHAT_RETENTION_DAYS=180
CHAT_DAILY_LIMIT=300
SCAN_DAILY_LIMIT=30
CART_REMINDER_HOURS=24
LOW_STOCK_LEVEL=
SHIPPING_STANDARD=
SHIPPING_EXPRESS=
AOV_TARGET=
